# Server-only settings. Copy to .env; never commit keys or tenant credentials.
COPILOT_PROVIDER=openai
COPILOT_BASE_URL=
COPILOT_MODEL=
COPILOT_API_KEY=
COPILOT_BEARER_TOKEN=
# Azure container only: renewable managed-identity tokens, not static keys.
COPILOT_USE_AZURE_IDENTITY=0
COPILOT_WIRE_API=completions
COPILOT_AZURE_API_VERSION=
# Approved Foundry ARM account resource ID for enabled deployment discovery.
COPILOT_AZURE_RESOURCE_ID=
COPILOT_LOCAL_NO_KEY=0
# Optional absolute path to a compatible Copilot runtime:
COPILOT_CLI_PATH=

# Synthetic MCP processes; no cloud API calls. Inference still needs BYOK.
IQ_DEMO_MODE=0
IQ_MCP_CONFIG=
# Exact operator-approved origins; users cannot grant trust or submit raw secrets.
IQ_MCP_TRUST_POLICY={"origins":[]}
# Origin-bound credential profiles: id/label/type/header+env or managed-identity scope.
IQ_MCP_AUTH_REFERENCES=[]
# Required for non-loopback HTTP binding; set the same secret in webui server env.
MCP_SERVICE_TOKEN=

# Live Fabric (when IQ_DEMO_MODE=0)
FABRIC_SQL_ENDPOINT=
FABRIC_SQL_DATABASE=EnterpriseKG_Lakehouse
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_ONTOLOGY_ID=
FABRIC_ONTOLOGY_MCP_URL=
ENTERPRISEIQ_ONTOLOGY_DEBUG=0

# Existing Foundry M6 Council / M7 Work IQ
PROJECT_ENDPOINT=
MODEL_DEPLOYMENT_NAME=
MODEL_DEPLOYMENT_NAME_FAST=
MODEL_DEPLOYMENT_NAME_PRO=
EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
M7_AGENT_NAME=
