# Copy to .env.local for local development.
MCP_BASE_URL=http://127.0.0.1:8765
# Server-to-server secret when MCP authentication is enabled; never NEXT_PUBLIC_*.
MCP_SERVICE_TOKEN=
IQ_DEMO_MODE=0
# This bypass is ignored in production. Bind local development to loopback.
IQ_LOCAL_AUTH_BYPASS=1
# Optional read-only operator source catalog; never user-entered paths.
IQ_DOCUMENT_CATALOG=
# Runtime Entra configuration, public identifiers only:
AAD_CLIENT_ID=
AAD_TENANT_ID=
# No COPILOT_API_KEY, provider credentials or NEXT_PUBLIC secret variables here.
